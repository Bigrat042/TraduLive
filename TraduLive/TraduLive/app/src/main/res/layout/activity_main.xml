<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TraduLive"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sous-titres traduits en direct, par-dessus n'importe quelle appli. Marche avec un casque sans fil, filaire, ou sans casque." />

        <!-- LANGUES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="1. Langues"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ma langue (celle que je veux lire)" />

        <Spinner
            android:id="@+id/spNative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Autre langue (quand la vidéo est dans ma langue, je traduis vers celle-ci)" />

        <Spinner
            android:id="@+id/spOther"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwap"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⇄ Inverser mes deux langues" />

        <RadioGroup
            android:id="@+id/rgDetect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Détecter la langue parlée automatiquement" />

            <RadioButton
                android:id="@+id/rbFixed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Je choisis la langue de la vidéo (plus fiable si elle ne change pas)" />
        </RadioGroup>

        <Spinner
            android:id="@+id/spFixed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- SOURCE AUDIO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="2. Source du son"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbInternal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Son interne du téléphone (recommandé : fonctionne avec tout casque ou sans)" />

            <RadioButton
                android:id="@+id/rbMic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Micro (pour une personne qui parle devant le téléphone, ou si une appli bloque la capture)" />
        </RadioGroup>

        <!-- MODELE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="3. Précision (modèle Whisper, local)"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvModelStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <ProgressBar
            android:id="@+id/progressModel"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Télécharger le modèle" />

        <!-- VITESSE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="4. Vitesse"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swPartials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Texte en direct pendant que la personne parle (ultra-réactif)" />

        <RadioGroup
            android:id="@+id/rgPower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbEco"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Économe (3 cœurs, chauffe peu)" />

            <RadioButton
                android:id="@+id/rbNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Équilibré (4 cœurs)" />

            <RadioButton
                android:id="@+id/rbMax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maximum (6 cœurs, le plus rapide, chauffe plus)" />
        </RadioGroup>

        <!-- AFFICHAGE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="5. Affichage des sous-titres"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swOriginal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Afficher aussi le texte original" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Taille du texte" />

        <SeekBar
            android:id="@+id/sbTextSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="22" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Opacité du fond" />

        <SeekBar
            android:id="@+id/sbOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="70" />

        <!-- AUTORISATIONS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="6. Réglages du téléphone (une seule fois)"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOverlayPerm"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Autoriser l'affichage par-dessus les autres applis" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBattery"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Batterie : ne pas limiter TraduLive (OnePlus)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:text="Démarrer les sous-titres"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Dans toutes les applis : ajoute la tuile « TraduLive » dans les réglages rapides (le volet qu'on baisse depuis le haut de l'écran, bouton crayon / modifier). Tu pourras ensuite démarrer et arrêter les sous-titres sans rouvrir TraduLive." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Chrome, Netflix, Prime Video, Disney+ et Spotify bloquent la capture du son interne : pour ces applis, utilise le mode Micro (YouTube, VLC, TikTok, Instagram, la plupart des autres applis marchent en mode interne)." />

        <!-- TRANSCRIPTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Transcription"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Partager / copier la transcription" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearLog"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Effacer la transcription" />
    </LinearLayout>
</ScrollView>
